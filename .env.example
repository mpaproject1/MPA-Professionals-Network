NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Generate a unique random secret for each environment; never use this placeholder as-is.
JWT_SECRET=replace-me

# Required for Network-Plus field-level contact sharing. Generate a unique secret (32+ characters)
# for each environment and keep it stable; losing/changing it makes existing encrypted contact values unreadable.
NETWORK_PLUS_CONTACT_ENCRYPTION_KEY=
# Local development database example only. Set credentials in your local environment.
DATABASE_URL=postgresql://mpa:replace-with-local-password@127.0.0.1:5432/mpa

# Production authentication/session hardening
AUTH_SESSION_DAYS=7

# Required for database-backed API routes, registration human checks, and membership expiry.
# Configure the DATABASE_URL above with your reachable PostgreSQL credentials and apply migrations before starting the API.

# Optional controlled bootstrap of a System Administrator; set BOTH email and password.
# These are read from the repository-root .env and host environment; host environment takes precedence.
# Never commit real credentials. Password must be at least 14 characters.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Legacy aliases are supported if the SUPER_ADMIN variables are blank.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME="System Administrator"

# Enable only when the trusted reverse proxy overwrites X-Forwarded-For
# and direct API access is blocked; otherwise keep false. Needed so per-IP
# security rate limits distinguish portal visitors instead of the shared proxy.
TRUST_PROXY=false

# In production, set to the exact HTTPS origin(s) allowed for browser API access.
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Email verification and operations (configure a verified sender before production use)
PUBLIC_APP_URL=http://localhost:3001
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="MPA Network <verify@example.org>"
# Email verification is enforced before login and authenticated API access.
EMAIL_VERIFICATION_REQUIRED=true
# Registration human verification is enabled by default in production and disabled by default in development.
# Set true to require a five-minute, single-use challenge token; set false to explicitly disable it.
# Disabling is an operational security trade-off. Keep true on public production registrations.
HUMAN_CHALLENGE_REQUIRED=true
# Enable only after administrator passkey enrollment and recovery have been verified.
REQUIRE_ADMIN_PASSKEYS=false
WEBAUTHN_ORIGIN=http://localhost:3001
WEBAUTHN_RP_ID=localhost
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_DELIVERY_WEBHOOK_SECRET=
EMAIL_DELIVERY_WEBHOOK_URL=

# Chapa hosted membership checkout (start with a TEST key; never expose these to the browser)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_EXPECTED_MODE=test
CHAPA_CALLBACK_URL=https://api.example.org/api/v1/payments/chapa/webhook
CHAPA_RETURN_URL=https://portal.example.org/membership/payment
# Separate shared secret for normalized provider delivery-event callbacks (not the outbound send webhook secret).
EMAIL_DELIVERY_EVENT_WEBHOOK_SECRET=


# Optional Web Push delivery (generate with node scripts/generate-web-push-vapid-keys.js).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:replace-with-a-real-admin-email@example.org

# Disposable development Test Lab. Keep disabled outside an isolated development database.
# Set TEST_LAB_DATABASE_NAME to the exact value returned by PostgreSQL current_database().
TEST_LAB_ENABLED=false
TEST_LAB_DATABASE_NAME=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep this secret outside source control; 32 random bytes are required.
TEST_LAB_CREDENTIAL_ENCRYPTION_KEY=
# Required when Test Lab is enabled. Captures email/push and blocks hosted payment providers.
TEST_DELIVERY_MODE=capture
TEST_LAB_SIGN_IN_URL=http://localhost:3000/login

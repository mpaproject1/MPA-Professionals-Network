NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Generate a unique random secret for each environment; never use this placeholder as-is.
JWT_SECRET=replace-me
# Local development database example only. Set credentials in your local environment.
DATABASE_URL=postgresql://mpa:replace-with-local-password@127.0.0.1:5432/mpa

# Production authentication/session hardening
AUTH_SESSION_DAYS=7

# Required for database-backed API routes, registration human checks, and membership expiry.
# Configure the DATABASE_URL above with your reachable PostgreSQL credentials and apply migrations before starting the API.

# Optional controlled bootstrap of a System Administrator; set BOTH email and password.
# These are read from the repository-root .env and host environment; host environment takes precedence.
# Never commit real credentials. Password must be at least 14 characters.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Legacy aliases are supported if the SUPER_ADMIN variables are blank.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME="System Administrator"

# Enable only when the trusted reverse proxy overwrites X-Forwarded-For
# and direct API access is blocked; otherwise keep false. Needed so per-IP
# security rate limits distinguish portal visitors instead of the shared proxy.
TRUST_PROXY=false

# In production, set to the exact HTTPS origin(s) allowed for browser API access.
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Email verification and operations (configure a verified sender before production use)
PUBLIC_APP_URL=http://localhost:3001
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="MPA Network <verify@example.org>"
# Email verification is enforced before login and authenticated API access.
EMAIL_VERIFICATION_REQUIRED=true
# Enable in production to require a one-time human-check token during registration.
HUMAN_CHALLENGE_REQUIRED=false
# Enable only after administrator passkey enrollment and recovery have been verified.
REQUIRE_ADMIN_PASSKEYS=false
WEBAUTHN_ORIGIN=http://localhost:3001
WEBAUTHN_RP_ID=localhost
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_DELIVERY_WEBHOOK_SECRET=
EMAIL_DELIVERY_WEBHOOK_URL=
# Separate shared secret for normalized provider delivery-event callbacks (not the outbound send webhook secret).
EMAIL_DELIVERY_EVENT_WEBHOOK_SECRET=

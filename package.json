{
  "name": "et-professionals-network",
  "private": true,
  "version": "0.1.0",
  "description": "Ethiopian Muslim Professionals Association platform foundation",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "test:reference-portfolio": "node --test test/reference-portfolio/*.test.js test/p0/guided-profile.test.js",
    "test:marketplace": "node --test test/p0/marketplace-demand.test.js",
    "test:community-impact": "node --test test/platform/community-impact-governance.test.js test/platform/community-impact-score.test.js test/platform/community-impact-governance-ui.test.js test/platform/community-impact-governance.authorization.test.js test/platform/community-impact-claims.test.js test/platform/community-impact-detection.test.js test/platform/community-impact-workspace-recognition.test.js",
    "test:p2": "node --test test/p2/*.test.js",
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "notifications:dispatch-account-recovery": "node scripts/dispatch-account-recovery.js",
    "notifications:dispatch-web-push": "node scripts/dispatch-web-push.js",
    "notifications:dispatch-community-campaigns": "node scripts/dispatch-community-campaigns.js",
    "memberships:expire": "node scripts/expire-memberships.js",
    "web:build": "npm run build --workspace @mpa/web",
    "web:dev": "npm run dev --workspace @mpa/web",
    "test:e2e": "playwright test",
    "check:migrations:rollback": "node scripts/check-new-migration-compatibility.js",
    "network-plus:rotate-contact-key": "node scripts/rotate-network-plus-contact-key.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
